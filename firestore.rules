rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'joinedAt']) &&
             data.keys().size() <= 8 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             (data.joinedAt == request.time || data.joinedAt == resource.data.joinedAt) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000));
    }

    // --- Request Validation ---
    function isValidRequest(data) {
      return data.keys().hasAll(['authorUid', 'title', 'body', 'category', 'status', 'createdAt', 'anonymous', 'urgent']) &&
             data.keys().size() == 8 &&
             data.authorUid == request.auth.uid &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 200 &&
             data.body is string && data.body.size() >= 5 && data.body.size() <= 5000 &&
             data.category in ['money', 'goods', 'skills', 'other'] &&
             data.status in ['open', 'resolved', 'closed'] &&
             data.anonymous is bool &&
             data.urgent is bool &&
             (data.createdAt == request.time || data.createdAt == resource.data.createdAt);
    }

    // --- Offer Validation ---
    function isValidOffer(data) {
      return data.keys().hasAll(['requestId', 'requestAuthorUid', 'volunteerUid', 'message', 'type', 'createdAt']) &&
             data.keys().size() == 6 &&
             data.volunteerUid == request.auth.uid &&
             data.requestId is string &&
             data.requestAuthorUid is string &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 2000 &&
             data.type in ['money', 'goods', 'skills'] &&
             (data.createdAt == request.time || data.createdAt == resource.data.createdAt);
    }

    // --- Notification Validation ---
    function isValidNotification(data) {
      return data.keys().hasAll(['uid', 'type', 'data', 'read', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid is string &&
             data.type in ['new_offer', 'request_resolved', 'general'] &&
             data.read is bool &&
             data.createdAt == request.time;
    }

    // --- Rules ---

    // USERS
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'location', 'avatar']);
    }

    // REQUESTS
    match /requests/{requestId} {
      allow read, list: if true;
      allow create: if isSignedIn() && isValidRequest(incoming()) && isValidId(requestId);
      allow update: if isSignedIn() && isOwner(existing().authorUid) && isValidRequest(incoming()) &&
                    (
                      // Action: Resolve/Close
                      incoming().diff(existing()).affectedKeys().hasOnly(['status']) ||
                      // Action: Edit body/title
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'urgent'])
                    );
      allow delete: if isSignedIn() && isOwner(existing().authorUid);

      // OFFERS (Subcollection)
      match /offers/{offerId} {
        allow read: if isSignedIn() && (
          isOwner(resource.data.volunteerUid) || 
          isOwner(resource.data.requestAuthorUid)
        );
        allow create: if isSignedIn() && isValidOffer(incoming()) && isValidId(offerId);
        allow update: if isOwner(existing().volunteerUid) && isValidOffer(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['message', 'type']);
        allow delete: if isOwner(existing().volunteerUid);
      }
    }

    // NOTIFICATIONS
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(userId);
    }
  }
}
