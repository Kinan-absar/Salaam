{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "bio": { "type": "string" },
        "avatar": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "joinedAt"]
    },
    "Request": {
      "title": "Help Request",
      "description": "A request for help posted by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorUid": { "type": "string" },
        "anonymous": { "type": "boolean" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string", "enum": ["money", "goods", "skills", "other"] },
        "status": { "type": "string", "enum": ["open", "resolved", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "urgent": { "type": "boolean" }
      },
      "required": ["authorUid", "title", "body", "category", "status", "createdAt"]
    },
    "Offer": {
      "title": "Help Offer",
      "description": "An offer of help for a specific request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "requestAuthorUid": { "type": "string" },
        "volunteerUid": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["money", "goods", "skills"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "requestAuthorUid", "volunteerUid", "message", "type", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "enum": ["new_offer", "request_resolved", "general"] },
        "data": { "type": "object" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User records"
    },
    "/requests/{requestId}": {
      "schema": "Request",
      "description": "Help requests"
    },
    "/requests/{requestId}/offers/{offerId}": {
      "schema": "Offer",
      "description": "Offers for a specific request"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
